<Window x:Class="CodexMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Monitor"
        Width="68"
        Height="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="RedLightStyle" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0.16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRedLightActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="RedBlink">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:1">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.16" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="RedBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="YellowLightStyle" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0.16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsYellowLightActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="YellowBlink">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:2">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.16" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="YellowBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenLightStyle" TargetType="Ellipse">
            <Setter Property="Opacity" Value="0.16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGreenLightActive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="GreenBlink">
                            <Storyboard RepeatBehavior="Forever" Duration="0:0:1">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.16" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="GreenBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border Margin="0,16,0,0" Background="#F0121826" CornerRadius="22"
                BorderBrush="#475569" BorderThickness="1" Padding="11"
                MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown"
                MouseLeftButtonUp="DragArea_OnMouseLeftButtonUp"
                MouseMove="DragArea_OnMouseMove">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Ellipse Width="42" Height="42" Fill="#FFEF4444" Style="{StaticResource RedLightStyle}" />
                </Grid>
                <Grid Margin="0,8">
                    <Ellipse Width="42" Height="42" Fill="#FFFACC15" Style="{StaticResource YellowLightStyle}" />
                </Grid>
                <Grid>
                    <Ellipse Width="42" Height="42" Fill="#FF22C55E" Style="{StaticResource GreenLightStyle}" />
                </Grid>
            </StackPanel>
        </Border>
        <Button Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,2,0" Padding="0" Content="×" FontSize="18" FontWeight="SemiBold"
                Cursor="Hand" ToolTip="隐藏状态灯"
                Click="CloseButton_OnClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Setter Property="Foreground" Value="#FFF8FAFC" />
                    <Setter Property="Background" Value="#E0333B4F" />
                    <Setter Property="BorderBrush" Value="#FF64748B" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFDC2626" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
