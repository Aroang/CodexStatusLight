<Window x:Class="CodexMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Monitor"
        Width="68"
        Height="174"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#F0121826" CornerRadius="22" BorderBrush="#475569" BorderThickness="1"
            Padding="11" MouseLeftButtonDown="DragArea_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <Ellipse Width="42" Height="42" Fill="#FFEF4444" Opacity="{Binding RedLightOpacity}" />
            <Ellipse Width="42" Height="42" Fill="#FFFACC15" Opacity="{Binding YellowLightOpacity}" Margin="0,8" />
            <Ellipse Width="42" Height="42" Fill="#FF22C55E" Opacity="{Binding GreenLightOpacity}" />
        </StackPanel>
    </Border>
</Window>
